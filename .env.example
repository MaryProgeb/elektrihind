# Copy to .env for local runs. Never commit .env.
# Production uses the same names as GitHub Actions secrets/env.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Default 0.24 (24% VAT).
VAT=0.24

# Optional. Default Europe/Tallinn.
TIMEZONE=Europe/Tallinn

# Optional local HH:MM bounds on the remaining-day search.
# EARLIEST_START=08:00
# LATEST_END=22:00
